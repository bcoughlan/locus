shape: sequence_diagram

dev: Developer
cmd: "runDiff()"
compare: "compareFiles()"
store: "DocumentStore"
build: "buildDocument()"
diff: "diffDocument()"
render: "renderConsole()"
html: "renderHtml()"

dev -> cmd: "locus diff --source old new"
cmd -> cmd: "expandPatterns(): files per side"
cmd -> compare: "base files, head files"
compare -> store: "load each file"
compare -> build: "each OpenAPI document"
build -> compare: "DocumentModel"
compare -> diff: "each file pair"
diff -> compare: "DocumentDiff"
compare -> cmd: "DiffReport"
cmd -> render: "report"
render -> cmd: "text"
cmd -> dev: "text on stdout"
cmd -> html: "report (only with --html)"
html -> cmd: "HTML page"
cmd -> dev: "HTML file, exit code"
