shape: sequence_diagram

caller: "caller\n(parameter, body, property)"
node: "schemaNode()"
ref: "asReference()"
store: "DocumentStore.deref()"
def: "definition()"
table: "ctx.schemas"
flat: "flatten()"
kids: "schemaChildren()"

caller -> node: "schema at file + pointer"
node -> ref: 'only a $ref?'
plain: "a plain reference" {
  ref -> node: 'yes: $ref, docs, nullable'
  node -> store: "follow the pointer"
  store -> node: "target: file, pointer, name"
  node -> def: "target, direction"
  def -> table: "id known?"
  table -> def: "no: add the node now\n(a cycle finds it)"
  def -> flat: "merge allOf members"
  def -> kids: "properties, items, variants"
  kids -> node: "schemaNode() for each child"
  def -> node: "id"
  node -> caller: "node with ref = id"
}
other: "any other schema" {
  ref -> node: "no"
  node -> flat: "merge allOf members"
  node -> kids: "children, built in place"
  node -> caller: "node with children"
}
