shape: sequence_diagram

render: "renderConsole()\nor renderHtml()"
docs: "DocsBuilder\ndocs.ts"
digest: "digest()"
layout: "SchemaLayout\nlayout.ts"
show: "show()\nformat.ts"
guard: "stopAt()"

render -> docs: "documentView(doc)"
docs -> layout: "new SchemaLayout(doc.schemas)\ndistances = changeDistances()"
docs -> layout: "startEndpoint(), for each endpoint"
docs -> digest: "changed endpoint"
digest -> docs: "DigestEntry[]: where, what, reason"
docs -> layout: "schemaBody(node)\nfor each parameter, header, media type"
layout -> show: "node"
show -> layout: "facts, changes, children\n(definition merged in)"
layout -> guard: "expand this ref?"
guard -> layout: "no: recursive, shown above,\nor not on a shortest path to a change\n(large endpoint)"
guard -> layout: "yes"
layout -> docs: "schema lines"
docs -> render: "DocumentView"
render -> render: "console: indented text, summary\nHTML: docs page, pills, sidebar, toggle"
